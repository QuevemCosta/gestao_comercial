import { LineEdit, ComboBox, ScrollView, AboutSlint, CheckBox, Palette } from "std-widgets.slint";

export struct DashCard {
    label: string,
    value: string,
}

export struct ProductRow {
    id: string,
    sku: string,
    name: string,
    category: string,
    sale-price: string,
    stock: string,
    status: string,
}

export struct CategoryRow {
    id: string,
    name: string,
    status: string,
}

export struct CustomerRow {
    id: string,
    name: string,
    document: string,
    phone: string,
    status: string,
}

export struct MovementRow {
    occurred: string,
    kind: string,
    delta: string,
    balance: string,
    reason: string,
}

export struct OrderRow {
    id: string,
    created: string,
    customer: string,
    status: string,
    total: string,
}

export struct ItemRow {
    index: int,
    product: string,
    quantity: string,
    unit-price: string,
    discount: string,
    total: string,
}

export struct SaleRow {
    id: string,
    number: string,
    customer: string,
    status: string,
    total: string,
    payment: string,
}

export struct PaymentRow {
    occurred: string,
    method: string,
    amount: string,
    notes: string,
}

export struct BalanceRow {
    id: string,
    number: string,
    customer: string,
    total: string,
    balance: string,
}

export struct RentalItemRow {
    id: string,
    name: string,
    category: string,
    price: string,
    total: string,
    status: string,
}

export struct RentalRow {
    id: string,
    number: string,
    customer: string,
    status: string,
    period: string,
    total: string,
    balance: string,
}

export struct RentalLineRow {
    index: int,
    item: string,
    quantity: string,
    returned: string,
    damaged: string,
    lost: string,
    outstanding: string,
}

export struct DraftLineRow {
    index: int,
    item-id: string,
    item: string,
    quantity: string,
    price: string,
    total: string,
}

export struct DelivererRow {
    id: string,
    name: string,
    phone: string,
    document: string,
    status: string,
}

export struct DeliveryRow {
    id: string,
    schedule: string,
    customer: string,
    status: string,
    deliverer: string,
    fee: string,
}

export struct ReportRow {
    c1: string,
    c2: string,
    c3: string,
    c4: string,
    c5: string,
}

// ---------- Tema ----------
global Theme {
    out property <color> sidebar: #1c2536;
    out property <color> sidebar-hover: #263146;
    out property <color> sidebar-text: #c9d2e0;
    out property <color> sidebar-muted: #7f8a9e;

    out property <color> background: #f3f5fa;
    out property <color> surface: #ffffff;
    out property <color> surface-hover: #f7f9fd;
    out property <color> surface-header: #eef2f8;
    out property <color> row-hover: #f4f7fd;
    out property <color> border: #e2e7f0;

    out property <color> text: #1c2433;
    out property <color> text-muted: #667085;
    out property <color> text-disabled: #a3acba;
    out property <color> text-danger: #b42318;
    out property <color> text-success: #17724a;
    out property <color> text-warning: #9a5b00;

    out property <color> primary: #3f6ee8;
    out property <color> primary-hover: #3561d6;
    out property <color> primary-pressed: #2a50b8;
    out property <color> primary-soft: #e8effd;

    out property <color> danger: #d92d20;
    out property <color> danger-hover: #fbdcd9;
    out property <color> danger-soft: #fdecea;

    out property <color> success: #1d9c64;
    out property <color> success-soft: #e7f6ee;

    out property <color> warning: #e0a526;
    out property <color> warning-soft: #fdf3dc;

    out property <color> disabled: #e6e9ef;
    out property <color> tooltip-bg: #1c2433;
}

// ---------- Campos de formulário ----------
// Altura fixa e sem esticamento vertical: evita campos excessivamente altos dentro de layouts.

component FormInput inherits LineEdit {
    height: 36px;
    vertical-stretch: 0;
}

component FormChoice inherits ComboBox {
    height: 36px;
    vertical-stretch: 0;
}

// ---------- Componentes base ----------

component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
}

component PageHeader inherits VerticalLayout {
    in property <string> heading;
    in property <string> subtitle: "";
    spacing: 2px;

    Text {
        text: root.heading;
        font-size: 24px;
        font-weight: 700;
        color: Theme.text;
    }
    if root.subtitle != "" : Text {
        text: root.subtitle;
        font-size: 13px;
        color: Theme.text-muted;
    }
}

component SectionTitle inherits Text {
    font-size: 15px;
    font-weight: 600;
    color: Theme.text;
}

component GroupLabel inherits Text {
    font-size: 11px;
    font-weight: 600;
    color: Theme.sidebar-muted;
}

component FieldLabel inherits Text {
    font-size: 13px;
    color: Theme.text-muted;
}

// Rótulo com ícone de ajuda. Ao passar o mouse, mostra uma dica curta.
component HelpLabel inherits HorizontalLayout {
    in property <string> label;
    in property <string> help;
    spacing: 6px;
    height: 18px;
    vertical-stretch: 0;

    FieldLabel {
        text: root.label;
        vertical-alignment: center;
    }

    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.text-muted;
        background: help-touch.has-hover ? Theme.primary-soft : transparent;

        Text {
            width: parent.width;
            height: parent.height;
            text: "i";
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 11px;
            font-weight: 700;
            color: Theme.text-muted;
        }

        help-touch := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
        }

        // Balão exibido enquanto o mouse estiver sobre o ícone.
        if help-touch.has-hover : Rectangle {
            x: parent.width + 8px;
            y: -10px;
            width: 280px;
            height: tip-text.preferred-height + 20px;
            z: 10;
            border-radius: 6px;
            background: Theme.tooltip-bg;

            tip-text := Text {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                text: root.help;
                wrap: word-wrap;
                font-size: 12px;
                color: #ffffff;
            }
        }
    }

    Rectangle { horizontal-stretch: 1; }
}

component InfoRow inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 2px;

    FieldLabel { text: root.label; }
    Text {
        text: root.value;
        wrap: word-wrap;
        color: Theme.text;
    }
}

// Botão com largura calculada pelo texto e margem lateral fixa.
component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked();

    height: 36px;
    width: max(96px, label.preferred-width + 36px);
    vertical-stretch: 0;
    horizontal-stretch: 0;
    border-radius: 6px;
    border-width: root.primary ? 0px : 1px;
    border-color: root.danger ? Theme.danger : Theme.border;
    background: !root.enabled ? Theme.disabled
        : root.primary ? (touch.pressed ? Theme.primary-pressed : (touch.has-hover ? Theme.primary-hover : Theme.primary))
        : root.danger ? (touch.has-hover ? Theme.danger-hover : Theme.danger-soft)
        : (touch.has-hover ? Theme.surface-hover : Theme.surface);

    label := Text {
        x: 18px;
        y: 0px;
        width: parent.width - 36px;
        height: parent.height;
        text: root.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 14px;
        font-weight: 600;
        color: !root.enabled ? Theme.text-disabled
            : root.primary ? #ffffff
            : root.danger ? Theme.text-danger
            : Theme.text;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Botão de texto discreto, usado para "Voltar para listagem".
component LinkButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 32px;
    width: label.preferred-width + 24px;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: touch.has-hover ? Theme.surface-header : transparent;

    label := Text {
        x: 12px;
        y: 0px;
        height: parent.height;
        text: root.text;
        vertical-alignment: center;
        font-size: 14px;
        font-weight: 600;
        color: Theme.primary;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 36px;
    border-radius: 8px;
    background: root.active ? Theme.primary : (touch.has-hover ? Theme.sidebar-hover : transparent);

    Text {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.label;
        vertical-alignment: center;
        font-size: 14px;
        font-weight: root.active ? 600 : 400;
        color: root.active ? #ffffff : Theme.sidebar-text;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component ListRow inherits Rectangle {
    in property <bool> selected: false;
    callback clicked();

    height: 40px;
    border-radius: 6px;
    background: root.selected ? Theme.primary-soft : (touch.has-hover ? Theme.row-hover : Theme.surface);

    @children

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

component TableHead inherits Rectangle {
    height: 30px;
    border-radius: 6px;
    background: Theme.surface-header;

    @children
}

component StatCard inherits Card {
    in property <string> label;
    in property <string> value;
    in property <color> accent: Theme.primary;
    callback clicked();

    min-height: 96px;
    horizontal-stretch: 1;
    background: touch.has-hover ? Theme.surface-hover : Theme.surface;

    Rectangle {
        x: 0px;
        y: 14px;
        width: 4px;
        height: parent.height - 28px;
        border-radius: 2px;
        background: root.accent;
    }

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        padding: 16px;
        padding-left: 22px;
        spacing: 6px;

        Text {
            text: root.label;
            font-size: 13px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        Text {
            text: root.value;
            font-size: 24px;
            font-weight: 700;
            color: Theme.text;
            overflow: elide;
        }
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.clicked(); }
    }
}

// ---------- Janela principal ----------

export component MainWindow inherits Window {
    title: "Gestão Comercial";
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 1000px;
    min-height: 680px;

    init => {
        Palette.color-scheme = ColorScheme.light;
    }
    background: Theme.background;

    in-out property <string> page: "dashboard";
    in-out property <string> message: "";
    in-out property <bool> message-is-error: false;

    // Guia interna de cada módulo: 0 = listagem, 1 = formulário.
    // Quem troca a guia é o Rust, conforme o resultado da ação (ver app.rs).
    in-out property <int> product-tab: 0;
    in-out property <int> customer-tab: 0;
    in-out property <int> order-tab: 0;
    in-out property <int> sale-tab: 0;
    in-out property <int> rental-tab: 0;

    in-out property <[DashCard]> dash-cards: [];

    // ---------- Categorias e produtos ----------
    in-out property <[string]> category-options: [];
    in-out property <[CategoryRow]> categories: [];
    in-out property <string> category-id: "";
    in-out property <string> category-name: "";

    in-out property <[ProductRow]> products: [];
    in-out property <string> product-search: "";
    in-out property <string> product-id: "";
    in-out property <string> product-sku: "";
    in-out property <string> product-name: "";
    in-out property <string> product-description: "";
    in-out property <string> product-purchase: "";
    in-out property <string> product-sale: "";
    in-out property <string> product-min-stock: "0";
    in-out property <string> product-unit: "un";
    in-out property <int> product-category-index: 0;
    in-out property <string> product-stock: "";

    // ---------- Estoque ----------
    in-out property <[ProductRow]> stock-items: [];
    in-out property <string> stock-alert: "";
    in-out property <string> stock-selected-id: "";
    in-out property <string> stock-selected-label: "Selecione um produto na lista";
    in-out property <string> stock-amount: "";
    in-out property <string> stock-reason: "";
    in-out property <[MovementRow]> movements: [];

    // ---------- Clientes ----------
    in-out property <[CustomerRow]> customers: [];
    in-out property <string> customer-search: "";
    in-out property <string> customer-id: "";
    in-out property <string> customer-name: "";
    in-out property <int> customer-person-index: 0;
    in-out property <string> customer-document: "";
    in-out property <string> customer-phone: "";
    in-out property <string> customer-whatsapp: "";
    in-out property <string> customer-street: "";
    in-out property <string> customer-neighborhood: "";
    in-out property <string> customer-city: "";
    in-out property <string> customer-notes: "";

    // ---------- Listas de apoio ----------
    in-out property <[string]> customer-options: [];
    in-out property <[string]> product-options: [];

    // ---------- Pedidos ----------
    in-out property <[OrderRow]> orders: [];
    in-out property <string> order-search: "";
    in-out property <string> order-id: "";
    in-out property <int> order-customer-index: -1;
    in-out property <int> order-origin-index: 0;
    in-out property <int> order-mode-index: 0;
    in-out property <string> order-street: "";
    in-out property <string> order-neighborhood: "";
    in-out property <string> order-city: "";
    in-out property <string> order-discount: "0,00";
    in-out property <string> order-notes: "";
    in-out property <string> order-status: "Novo pedido";
    in-out property <string> order-totals: "";
    in-out property <bool> order-editable: true;
    in-out property <[ItemRow]> order-items: [];
    in-out property <int> order-item-product-index: -1;
    in-out property <string> order-item-quantity: "1";
    in-out property <string> order-item-price: "";
    in-out property <string> order-item-discount: "0,00";

    // ---------- Vendas ----------
    in-out property <[SaleRow]> sales: [];
    in-out property <string> sale-search: "";
    in-out property <string> sale-id: "";
    in-out property <string> sale-title: "Selecione uma venda";
    in-out property <string> sale-totals: "";
    in-out property <[ItemRow]> sale-items: [];
    in-out property <[PaymentRow]> sale-payments: [];
    in-out property <string> sale-cancel-reason: "";

    // ---------- Pagamentos ----------
    in-out property <[BalanceRow]> balances: [];
    in-out property <string> pay-sale-id: "";
    in-out property <string> pay-title: "Selecione uma venda";
    in-out property <string> pay-summary: "";
    in-out property <[PaymentRow]> pay-history: [];
    in-out property <string> pay-amount: "";
    in-out property <int> pay-method-index: 0;
    in-out property <string> pay-notes: "";

    // ---------- Itens de locação ----------
    in-out property <[RentalItemRow]> rental-items: [];
    in-out property <string> rental-item-id: "";
    in-out property <string> rental-item-name: "";
    in-out property <string> rental-item-description: "";
    in-out property <string> rental-item-category: "";
    in-out property <string> rental-item-price: "";
    in-out property <string> rental-item-notes: "";
    in-out property <string> rental-item-initial: "0";
    in-out property <string> rental-item-units: "";
    in-out property <string> rental-item-reason: "";

    // ---------- Locações ----------
    in-out property <[string]> rental-item-options: [];
    in-out property <[RentalRow]> rentals: [];
    in-out property <string> rental-search: "";
    in-out property <string> rental-id: "";
    in-out property <string> rental-title: "Nova locação";
    in-out property <string> rental-summary: "";
    in-out property <[RentalLineRow]> rental-lines: [];
    in-out property <[string]> rental-line-options: [];
    in-out property <int> rental-customer-index: -1;
    in-out property <string> rental-pickup: "";
    in-out property <string> rental-expected: "";
    in-out property <string> rental-discount: "0,00";
    in-out property <int> rental-draft-item-index: -1;
    in-out property <string> rental-draft-quantity: "1";
    in-out property <string> rental-draft-price: "";
    in-out property <[DraftLineRow]> rental-draft: [];
    in-out property <string> rental-cancel-reason: "";
    in-out property <int> rental-return-line-index: -1;
    in-out property <string> rental-return-returned: "0";
    in-out property <string> rental-return-damaged: "0";
    in-out property <string> rental-return-lost: "0";
    in-out property <string> rental-return-notes: "";
    in-out property <string> rental-pay-amount: "";
    in-out property <int> rental-pay-method-index: 0;
    in-out property <string> rental-pay-notes: "";

    // ---------- Entregadores ----------
    in-out property <[DelivererRow]> deliverers: [];
    in-out property <[string]> deliverer-options: [];
    in-out property <string> deliverer-id: "";
    in-out property <string> deliverer-name: "";
    in-out property <string> deliverer-phone: "";
    in-out property <string> deliverer-document: "";
    in-out property <string> deliverer-notes: "";

    // ---------- Entregas ----------
    in-out property <[DeliveryRow]> deliveries: [];
    in-out property <[DashCard]> delivery-panel: [];
    in-out property <int> delivery-view-index: 0;
    in-out property <string> delivery-date: "";
